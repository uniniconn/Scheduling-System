{
  "name": "scheduling-system",
  "version": "1.0.0",
  "private": true,
  "description": "排班系统：管理员发布排班任务，用户凭链接+密码填写排班意愿，系统自动匹配排班。",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "db:switch:postgres": "node scripts/switch-provider.mjs postgresql",
    "db:switch:sqlite": "node scripts/switch-provider.mjs sqlite",
    "setup": "prisma generate && prisma migrate deploy",
    "start:prod": "prisma migrate deploy && next start -p 3000",
    "e2e": "node --experimental-strip-types scripts/e2e-test.mjs",
    "one-click": "node scripts/launcher.mjs start",
    "one-click:background": "node scripts/launcher.mjs start --background",
    "stop": "node scripts/launcher.mjs stop",
    "status": "node scripts/launcher.mjs status",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "jszip": "3.10.2",
    "next": "15.5.27",
    "prisma": "6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
