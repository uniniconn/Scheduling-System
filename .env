# ---------- 运行环境 ----------
NODE_ENV=development

# ---------- 数据库 ----------
# 本地默认 SQLite；云服务器改成 postgresql（并同步修改 DATABASE_URL）
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./data/app.db"

# PostgreSQL 示例（云服务器）：
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://sched:change-me@127.0.0.1:5432/scheduling?schema=public"

# ---------- 会话与安全 ----------
SESSION_SECRET="DIqak/ReXe5gSFHSHk4KNJr+odSSfiPN+sNHJImKQNwKHOm6/HNMLHGGZyQo6+GH"
SESSION_TTL_HOURS=12
FILL_SESSION_TTL_HOURS=12

# ---------- 初始管理员（首次启动自动创建） ----------
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="Admin@12345"
INITIAL_ADMIN_DISPLAY_NAME="系统管理员"

# ---------- 站点地址 ----------
BASE_URL="http://localhost:3000"
COOKIE_SECURE=false

# ---------- 限流（填写端） ----------
FILL_RATE_LIMIT_MAX=30
FILL_RATE_LIMIT_WINDOW=60
FILL_PASSWORD_MAX_ATTEMPTS=10
FILL_PASSWORD_WINDOW=300

# ---------- Docker Compose 用（Postgres 容器） ----------
POSTGRES_USER=sched
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scheduling
