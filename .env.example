# ---------- 运行环境 ----------
NODE_ENV=development

# ---------- 数据库 ----------
# 本地默认 SQLite。
# 注意：Prisma 不允许 datasource provider 使用 env()，因此真实的 provider 写在
# prisma/schema.prisma 中；切换请用脚本（会同步 schema 与迁移目录）：
#     npm run db:switch:postgres      # 切换为 PostgreSQL
#     npm run db:switch:sqlite         # 切回 SQLite
# 本变量供 docker-compose / Dockerfile 的构建参数与容器内迁移判断使用。
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./data/app.db"

# PostgreSQL 示例（云服务器）：
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://sched:change-me@127.0.0.1:5432/scheduling?schema=public"

# ---------- 会话与安全 ----------
# 生产环境必须替换为随机长字符串：openssl rand -base64 48
SESSION_SECRET="please-change-me-to-a-long-random-string-at-least-32-chars"
# 管理员登录会话有效期（小时）
SESSION_TTL_HOURS=12
# 用户填写端的任务通行凭证有效期（小时）
FILL_SESSION_TTL_HOURS=12

# ---------- 初始管理员（首次启动自动创建） ----------
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="Admin@12345"
INITIAL_ADMIN_DISPLAY_NAME="系统管理员"

# ---------- 站点地址 ----------
# 本地：http://localhost:3000 ；云服务器：https://your-domain.com
BASE_URL="http://localhost:3000"
# 反向代理后是否强制 https 会话 Cookie（生产环境建议 true）
COOKIE_SECURE=false

# ---------- 限流（填写端） ----------
# 同一 IP 每窗口最大填写端写请求次数
FILL_RATE_LIMIT_MAX=30
# 限流窗口（秒）
FILL_RATE_LIMIT_WINDOW=60
# 同一任务 + IP 密码尝试次数上限 / 窗口（秒）
FILL_PASSWORD_MAX_ATTEMPTS=10
FILL_PASSWORD_WINDOW=300

# ---------- Docker Compose 用（Postgres 容器） ----------
POSTGRES_USER=sched
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scheduling
